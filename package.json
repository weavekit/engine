{
  "name": "@weave-kit/engine",
  "version": "0.5.0",
  "description": "WeaveKit engine — a metadata-driven headless backend runtime with Git-versioned metadata",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "default": "./dist/values.js"
    },
    "./layout": {
      "types": "./dist/layout-format.d.ts",
      "default": "./dist/layout-format.js"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "weavekit",
    "headless",
    "metadata",
    "git",
    "versioning",
    "schema",
    "postgres",
    "rest",
    "mcp",
    "rbac",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/weavekit/engine.git"
  },
  "homepage": "https://github.com/weavekit/engine",
  "bugs": {
    "url": "https://github.com/weavekit/engine/issues"
  },
  "author": "WeaveKit <support@weavekit.io>",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "prelint": "node scripts/check-memory-sizes.mjs",
    "lint": "eslint .",
    "openapi:docs": "node --import tsx scripts/generate-openapi.mjs",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --env-file-if-exists=.env --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"tests/e2e/*.test.ts\""
  },
  "bin": {
    "weave": "./dist/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "eslint": "^9.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pgsql/traverse": "^18.7.7",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "esbuild": "^0.25.0",
    "fastify": "^5.11.2",
    "kleur": "^4.1.5",
    "pg": "^8.22.0",
    "pgsql-parser": "^18.2.6",
    "tsx": "^4.20.0"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.1"
  }
}
