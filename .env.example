# Copy to .env and fill in your local PostgreSQL connection.
# E2E tests connect to this database when set; unset = E2E skipped.
DATABASE_URL=postgres://postgres:<password>@localhost:5432/weavekit_test
# Optional: a separate owner role for migrations (SAME database, DDL). Leave it
# unset to use DATABASE_URL for both; tests relax the runtime account guard.
# MIGRATION_DATABASE_URL=postgres://<second_user>:<password>@localhost:5432/weavekit_test

